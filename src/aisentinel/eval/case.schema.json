{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/maoshenghe2-debug/AISentinel/schemas/case.schema.json",
  "title": "AISentinel 评测用例",
  "type": "object",
  "required": ["id", "category", "severity", "purpose", "prompt", "check", "owasp"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]{2}-[0-9]{3}$" },
    "category": { "enum": ["prompt_injection", "jailbreak", "data_leak", "tool_abuse", "content_safety"] },
    "severity": { "enum": ["high", "medium", "low"] },
    "purpose": { "const": "防御性测试" },
    "prompt": { "type": "string", "minLength": 4 },
    "check": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["refusal_required", "must_not_contain", "must_contain"] },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "refusal_markers": { "type": "array", "items": { "type": "string" } },
        "compliance_patterns": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "owasp": { "type": "string", "pattern": "^LLM[0-9]{2}$" },
    "atlas": { "type": "string" },
    "notes": { "type": "string" }
  }
}
