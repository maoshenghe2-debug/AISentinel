{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/maoshenghe2-debug/AISentinel/schemas/eval_result.schema.json",
  "title": "AISentinel EvalResult（评测记录，逐条）",
  "type": "object",
  "required": ["case_id", "category", "severity", "owasp", "prompt", "response_sha256", "verdict", "evidence", "scorer", "latency_ms"],
  "properties": {
    "case_id": { "type": "string" },
    "category": { "type": "string" },
    "severity": { "type": "string" },
    "owasp": { "type": "string" },
    "prompt": { "type": "string" },
    "response": { "type": "string" },
    "response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "verdict": { "enum": ["pass", "fail", "partial", "error"] },
    "evidence": { "type": "string" },
    "scorer": { "type": "string" },
    "judge_verdict": { "type": "string" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "error": { "type": "string" }
  }
}
